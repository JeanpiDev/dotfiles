# Copiar a ~/.config/restic/restic.env y rellenar. Modo 0600.
# ESTE FICHERO ES LA PLANTILLA: nunca pongas valores reales aquí.

# --- Destino local (provisional) ---
RESTIC_REPOSITORY=/ruta/a/tu/repositorio

# --- Destino remoto: Backblaze B2 ---
# RESTIC_REPOSITORY=b2:NOMBRE-DEL-BUCKET:omarchy
# B2_ACCOUNT_ID=tu_keyID
# B2_ACCOUNT_KEY=tu_applicationKey

# La clave de cifrado vive fuera del repositorio, en un fichero 0600.
# Si se pierde, el backup es ilegible para siempre: guárdala en un gestor
# de contraseñas.
RESTIC_PASSWORD_FILE=/home/USUARIO/.config/restic/password
